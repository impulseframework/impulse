const (
	migrationsSource = "file://../../schema/migrations"

	// devSeedSource is the development seed, applied beside the schema: the tenants a
	// development run starts with.
	devSeedSource = "file://../../schema/devseed"

	// north is a tenant of the development seed, by the id the seed gives it: the tenant
	// a domain role's grants are proven in.
	north = "[[.North]]"

	// The development login the served suites sign in as.
	adminUser     = "admin"
	adminPassword = "open-the-console-first"
)

// servedConfigurer implements app.Configurer over the real dependencies: the test
// database, the real permission engine, and a real session manager, so the suites
// exercise the same served stack main composes.
type servedConfigurer struct {
	db      *initiator.SpannerDB
	auth    *staff.Auth
	live    *live.Fake
	tenants *resource.TenantRoster
}

// TenantRoster is the tenant roster over the test database, read from the table the
// development seed filled and kept current as production's data level keeps it: a tenant
// written through the API reaches it after the commit, and the served stack filters it
// by the engine's foothold answer.
func (c *servedConfigurer) TenantRoster() *resource.TenantRoster {
	return c.tenants
}

// TenantDeclarations is the roster's copy of what each tenant declares about who may
// enter it, as production's data level answers.
func (c *servedConfigurer) TenantDeclarations() resource.TenantDeclarations {
	return c.tenants.Declarations
}

func (c *servedConfigurer) ResourceClient() resource.Client {
	return resource.NewSpannerClient(c.db.Client)
}

// CursorKey seals the cursors the suites' paged lists issue; any key serves a test process.
func (c *servedConfigurer) CursorKey() *resource.CursorKey {
	key, err := resource.NewCursorKey(base64.StdEncoding.EncodeToString([]byte("skeleton-test-cursor-key-material!!")))
	if err != nil {
		panic(err)
	}

	return key
}

func (c *servedConfigurer) Access() access.Controller { return c.auth.Access() }

func (c *servedConfigurer) Staff() *staff.Auth { return c.auth }

// StaffIdentity is the staff auth's identity client, which the test auth built when it
// opened as the served application's does, so the suites drive the generated management
// as the served application does.
func (c *servedConfigurer) StaffIdentity() *staffidentity.Client { return c.auth.Identity() }

func (c *servedConfigurer) Validator() *validator.Validate { return validator.New() }

func (c *servedConfigurer) LogExporter() logger.Exporter { return logger.NewConsoleExporter() }

// AppVersion is dev: the served stack's version check answers every release, so no
// suite's request is refused for the release it carries.
func (c *servedConfigurer) AppVersion() string {
	return "dev"
}

// Environment is none: the suites run as production does, which names no environment.
func (c *servedConfigurer) Environment() string {
	return ""
}

func (c *servedConfigurer) ConsoleDist() string { return "" }

// Live is the in-memory live service the auth's permission engine signals policy
// changes through: the live service is required in every application.
func (c *servedConfigurer) Live() live.Service {
	return c.live
}

// LiveOrigins names no change feed origin: the suites serve no live pages.
func (c *servedConfigurer) LiveOrigins() []string {
	return nil
}

// served is one running instance of the application under test.
type served struct {
	server *httptest.Server
	access *access.Client
	// db is the suite's database, where a suite reads what a request left behind.
	db *initiator.SpannerDB
	// auth is the staff auth the instance binds to, for a suite that creates a login of
	// its own beside the development one.
	auth *staff.Auth
	// adminID is the development login's user id: what the methods of the auth's generated
	// management name the login by, and what the permission store holds its role under.
	adminID string
	// mail is the recorder the staff auth sends its mail to, where a suite reads the
	// sign-in code a sign-in waits for.
	mail *mail.Recorder
	// codeMu lets one sign-in at a time run its second factor on the stack, so the code a
	// browser reads from the recorder is its own, and trusted holds, per login, the token
	// of the browser the login asked to be remembered at their first sign-in, which their
	// later sign-ins carry (browser.signIn).
	codeMu  sync.Mutex
	trusted map[string]*http.Cookie
}

// newServed provisions the database the way the deployment does (the schema, the
// development seed beside it, then the auth opened over it with its embedded role file
// validated against the collection), creates the development login as the bootstrap does
// (the user, then its role, held by the id of the user's account), and serves the full
// router.
func newServed(ctx context.Context, t *testing.T) *served {
	t.Helper()

	return newServedMailing(ctx, t, nil)
}

// newServedMailing is newServed with the staff auth's mail sent through what through
// answers for the stack's recorder, for a suite that holds a message on its way to the
// mailbox; nil sends straight to the recorder.
func newServedMailing(ctx context.Context, t *testing.T, through func(to mail.Sender) mail.Sender) *served {
	t.Helper()

	db, err := prepareDatabase(ctx, t, migrationsSource, devSeedSource)
	if err != nil {
		t.Fatal(err)
	}

	// The live service the engine signals policy changes through, the App follows its
	// feature flags from, and the tenant roster reloads on: in-memory in the suites.
	svc := live.NewFake()
	// The tenant roster, started over the seeded tenants as production's data level
	// starts it.
	roster := app.New[[.Record]]Roster(resource.NewSpannerClient(db.Client), resource.WithTenantSignals(svc))
	if err := roster.Start(ctx); err != nil {
		t.Fatalf("resource.TenantRoster.Start() error = %v", err)
	}
	// The recorder the staff auth's mail goes to: the suites read the sign-in codes from it.
	sent := &mail.Recorder{}
	var sender mail.Sender = sent
	if through != nil {
		sender = through(sent)
	}
	auth, err := staff.New(ctx, db.Client, &staff.Settings{
		Collection: router.Collection(), Signals: svc, CookieKey: testCookieKey, SessionTimeout: time.Minute, Mail: sender, MailLoginURL: "http://solo.test/login",
		// The sign-in rule reads what each tenant declares in the sign-in's transaction,
		// through the generated reader[[if .Directories]]s[[end]], as production does.
		TenantDeclarations: app.New[[.Record]]DeclarationReader(),
[[- if .Directories]]
		TenantDirectories: app.New[[.Record]]DirectoryReader(),
[[- end]]
		// What makes a tenant from an accepted invitation, over the stack's roster and live
		// service, as production's data level hands it in.
		TenantMaker: app.New[[.Record]]Maker(roster, svc),
	})
	if err != nil {
		t.Fatalf("staff.New() error = %v", err)
	}
	t.Cleanup(func() {
		if err := auth.Close(); err != nil {
			t.Errorf("staff.Auth.Close() error = %v", err)
		}
	})
	accessClient := auth.Access()

	passwordAuth := auth.Session()
	password := adminPassword
	adminID, err := passwordAuth.API().CreateSessionUser(ctx, &session.CreateUserRequest{Username: adminUser, Password: &password})
	if err != nil {
		t.Fatalf("CreateSessionUser() error = %v", err)
	}
	// The role is held by the login's account: the permission store names a person by the
	// id of their account, never by the username, which is only what people read.
	if err := accessClient.UserManager().AddUserRoles(ctx, accesstypes.GlobalPolicyScope(), accesstypes.User(adminID.String()), accesstypes.SuperAdministrator, "Administrator"); err != nil {
		t.Fatalf("AddUserRoles(%s) error = %v", adminUser, err)
	}

	a := app.New(&servedConfigurer{db: db, auth: auth, live: svc, tenants: roster})
	// The App reads its feature flags as it is built; Start reports a copy that could
	// not be read and follows the table until the test ends.
	if err := a.Start(ctx); err != nil {
		t.Fatalf("app.Start() error = %v", err)
	}
	handler := router.New(a, router.Hooks{})
	server := httptest.NewServer(handler)
	t.Cleanup(server.Close)

	return &served{server: server, access: accessClient, auth: auth, db: db, adminID: adminID.String(), mail: sent, trusted: map[string]*http.Cookie{}}
}

// testCookieKey signs session cookies in the suites; any 32 bytes will do.
const testCookieKey = "dGVzdC1jb29raWUta2V5LXRlc3QtY29va2llLWtleS0xMjM0NTY="

// browser is one browser's view of the served application: a cookie jar and the XSRF
// token the session middleware issued into it.
type browser struct {
	t      *testing.T
	base   string
	client *http.Client
	// served is the stack the browser is on, whose recorder holds the code a sign-in
	// waits for and whose trusted tokens a remembered browser carries.
	served *served
}

func newBrowser(t *testing.T, s *served) *browser {
	t.Helper()

	jar, err := cookiejar.New(nil)
	if err != nil {
		t.Fatal(err)
	}

	return &browser{t: t, base: s.server.URL, client: &http.Client{Jar: jar}, served: s}
}

// login posts the credentials to the login route and returns the status.
func (b *browser) login(ctx context.Context, user, password string) (status int, body []byte) {
	b.t.Helper()

	credentials, err := json.Marshal(map[string]string{"username": user, "password": password})
	if err != nil {
		b.t.Fatal(err)
	}

	return b.do(ctx, http.MethodPost, "/api/user/password/login", credentials)
}

// do issues one request as this browser, carrying its cookies and XSRF token.
func (b *browser) do(ctx context.Context, method, path string, body []byte) (status int, respBody []byte) {
	b.t.Helper()

	req, err := http.NewRequestWithContext(ctx, method, b.base+path, bytes.NewReader(body))
	if err != nil {
		b.t.Fatal(err)
	}
	req.Header.Set("Content-Type", "application/json")
	if token := b.xsrfToken(); token != "" {
		req.Header.Set("X-XSRF-TOKEN", token)
	}

	resp, err := b.client.Do(req)
	if err != nil {
		b.t.Fatal(err)
	}
	defer resp.Body.Close()

	respBody, err = io.ReadAll(resp.Body)
	if err != nil {
		b.t.Fatal(err)
	}

	return resp.StatusCode, respBody
}

// xsrfToken returns the XSRF cookie the session middleware issued, or empty before the
// first response.
func (b *browser) xsrfToken() string {
	req, err := http.NewRequestWithContext(context.Background(), http.MethodGet, b.base+"/api/user/session", http.NoBody)
	if err != nil {
		b.t.Fatal(err)
	}
	for _, cookie := range b.client.Jar.Cookies(req.URL) {
		if cookie.Name == staff.XSRFCookie {
			return cookie.Value
		}
	}

	return ""
}

// prime starts the browser's XSRF handshake, as the login page does when it loads.
func (b *browser) prime(ctx context.Context) {
	b.t.Helper()

	if status, body := b.do(ctx, http.MethodGet, "/api/user/session", nil); status != http.StatusOK {
		b.t.Fatalf("GET /api/user/session before signing in: status %d: %s", status, body)
	}
}

// signInMethod is a row of the list the Sign-in page draws.
type signInMethod struct {
	Name       string `json:"name"`
	Admits     string `json:"admits"`
	OpenSignUp bool   `json:"openSignUp"`
	Says       string `json:"says"`
}

// signInMethods reads the auth's sign-in methods as the Sign-in page lists them.
func signInMethods(ctx context.Context, t *testing.T, b *browser) []signInMethod {
	t.Helper()

	status, body := b.do(ctx, http.MethodGet, "/api/staff-sign-in-methods", nil)
	if status != http.StatusOK {
		t.Fatalf("GET /api/staff-sign-in-methods: status %d: %s", status, body)
	}
	var methods []signInMethod
	if err := json.Unmarshal(body, &methods); err != nil {
		t.Fatalf("decoding the sign-in methods: %v: %s", err, body)
	}

	return methods
}

// mailedToken finds the token of the link of the kind (signUp, invitation) among the
// messages the auth sent since before.
func mailedToken(t *testing.T, s *served, before int, kind string) string {
	t.Helper()

	link := regexp.MustCompile(`http://solo\.test/login#` + kind + `=([A-Za-z0-9_-]+)`)
	for _, m := range s.mail.Messages()[before:] {
		if match := link.FindStringSubmatch(m.Text); match != nil {
			return match[1]
		}
	}
	t.Fatalf("no %s link was mailed (%d messages before)", kind, before)

	return ""
}

// factorIfHeld completes the second factor where the answer says the sign-in waits for
// it, as the login page does.
func factorIfHeld(ctx context.Context, t *testing.T, b *browser, username string, body []byte) {
	t.Helper()

	if heldForFactor(t, body) {
		b.secondFactor(ctx, username, false)
	}
}

// invited has the administrator invite the address with the FeatureAdministrator role
// and the invited person create their account from the link and the code mailed to the
// address, whatever was chosen for the method: an invitation is the way in under either
// choice.
func invited(ctx context.Context, t *testing.T, s *served, admin *browser, email, username string) {
	t.Helper()

	before := len(s.mail.Messages())
	invite, err := json.Marshal(map[string]any{"email": email, "name": username, "roles": []string{"FeatureAdministrator"}})
	if err != nil {
		t.Fatal(err)
	}
	status, body := admin.do(ctx, http.MethodPost, "/api/invite-staff-user", invite)
	if status != http.StatusOK {
		t.Fatalf("POST /api/invite-staff-user for %s: status %d: %s", email, status, body)
	}
	token := mailedToken(t, s, before, "invitation")

	b := newBrowser(t, s)
	b.prime(ctx)
	if status, body := b.do(ctx, http.MethodPost, "/api/user/invitation", []byte(`{"token":"`+token+`"}`)); status != http.StatusOK {
		t.Fatalf("POST /api/user/invitation as %s: status %d: %s", username, status, body)
	}
	accept, err := json.Marshal(map[string]string{"password": "a-long-password", "username": username})
	if err != nil {
		t.Fatal(err)
	}
	status, body = b.do(ctx, http.MethodPost, "/api/user/invitation/sign-up", accept)
	if status != http.StatusOK || !heldForFactor(t, body) {
		t.Fatalf("POST /api/user/invitation/sign-up as %s: status %d: %s, want 200 held for the code mailed to the invited address", username, status, body)
	}
	b.secondFactor(ctx, username, false)
	if status, body := b.do(ctx, http.MethodGet, "/api/feature-flags", nil); status != http.StatusOK {
		t.Fatalf("GET /api/feature-flags as the invited %s: status %d, want 200 by the invitation's role: %s", username, status, body)
	}
}

// provesGrant names the conditional grant a test case proves. It parses the auth's role
// file (<auth>.Roles(), the file embedded in the auth package) and fails unless a grant for
// the role, permission, and resource carries exactly that condition text, so a case whose
// grant is gone or reworded fails here even when nobody ran impulse check, whose
// conditions-proven check reads these calls to find the conditional grants no case names.
// Write the file as the auth package's Roles() call and the coordinates as literals: the
// check reads them from the source.
[[- if .Proven]]
//
//nolint:unparam // The role file's conditional grants are all one role's today; the next role's case names its own.
[[- end]]
func provesGrant(t *testing.T, roles access.RoleFile, role accesstypes.Role, permission accesstypes.Permission, res accesstypes.Resource, condition string) {
	t.Helper()

	parsed, err := roles.Parse()
	if err != nil {
		t.Fatalf("parsing the role file: %v", err)
	}
	var conditions []string
	for _, r := range slices.Concat(parsed.Roles.Global, parsed.Roles.Domain) {
		if r.Name != role {
			continue
		}
		for _, g := range r.Permissions[permission] {
			if g.Resource != res {
				continue
			}
			if g.Condition == condition {
				return
			}
			conditions = append(conditions, g.Condition)
		}
	}
	t.Fatalf("no %s grant of the %s role on %s carries the condition %q (the file's conditions there: %q); the case proves a grant the file no longer carries", permission, role, res, condition, conditions)
}

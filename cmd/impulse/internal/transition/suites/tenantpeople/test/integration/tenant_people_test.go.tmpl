package integration

import (
	"context"
	"encoding/json"
[[- if not .Password]]
	"io"
[[- end]]
	"net/http"
[[- if .Password]]
	"slices"
[[- end]]
[[- if .Administrator]]
	"strings"
[[- end]]
	"testing"
	"time"

	"cloud.google.com/go/spanner"
	"github.com/impulseframework/impulse"
	"github.com/impulseframework/impulse/accesstypes"
[[- if .Password]]
	"github.com/impulseframework/impulse/accesstypes/condition"
[[- end]]
	"github.com/impulseframework/impulse/cmd/impulse/internal/skeleton/_candidates/solo/pkg/auth/staff"
	"github.com/impulseframework/impulse/session"
[[- if .Password]]
	"github.com/impulseframework/impulse/session/sessioninfo"
[[- end]]
)

// memberUser is the login of north's administrator, whom the test makes: an
// administrator of one tenant, who holds nothing else.
const memberUser = "member"

// TestTenantPeople_aTenantAdministratorActsOnTheTenantsOwnPeopleAlone proves the
// conditions the role file puts on a tenant administrator's grants over the tenant's
// people, on the served stack.
//
// An account is one row for the whole application: a person who holds a role in two
// tenants is one account, and so is a person who holds a role of the whole application
// beside a tenant's. One party manages it: the tenant whose directory the person signs
// in through, otherwise the one tenant the person holds roles in, otherwise the
// application's own administrators. The methods a tenant acts on an account through (a
// new name, a new address, a delete) change that one account, so the role file grants
// them to a tenant's administrator for the people whose account the tenant manages and
// nobody else (managedHere = true). Without the condition north's administrator could
// change an account that also manages the application. The same reasoning keeps the
// rest of the account to those people (managedHere = true): beyond the name, the
// address and whether the account is disabled, its dates, and the identities they sign
// in with
[[- if .Password]] and how they sign in. A password reset link goes to everyone but a
// person another tenant's directory manages (managedHere = true OR
// managedByAnotherDirectory = false)
[[- end]]. A role held in every tenant is the
// application's administrator's to take (everyDomain = false), and an invitation is
// withdrawn while it stands and not after (pending = true).
[[- if .Administrator]] The application's own
// administrator changes an account from the whole application's side only where no
// tenant manages it (managedByTenant = false): nora's is north's to change and not the
// application's, and gail's, who holds a role of the whole application too, is the
// application's.
[[- end]]
//
// The people: nora holds a role in north alone; sam in north and in south; gail in
// north and, for the whole application, FeatureAdministrator. Nobody here signs in
// through a tenant's directory, so north manages nora's account and nobody else's.
[[- if .OneTenant]] A
// person belongs to one tenant here unless they hold a role of the whole application,
// so sam is given FeatureAdministrator before the role in south. Both hold a role of
// the whole application, which alone keeps north from managing their accounts, so a
// fourth person shows the other way an account is not a tenant's: erin holds a role in
// north and the tenants' role in every tenant, which no tenant owns, and no role of the
// whole application. What keeps north from managing her account is the role she holds
// in every tenant.
[[- end]] The member is north's administrator and nothing else,
// so every answer here is the role file's.
func TestTenantPeople_aTenantAdministratorActsOnTheTenantsOwnPeopleAlone(t *testing.T) {
	t.Parallel()

	// The conditional grants this test proves, pinned to the role file: impulse check
	// reads these calls to find a conditional grant no test names.
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "List", "Staff[[.Record]]Users", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Read", "Staff[[.Record]]Users", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "List", "Staff[[.Record]]Identities", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Read", "Staff[[.Record]]Identities", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "DisableStaff[[.Record]]User", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "EnableStaff[[.Record]]User", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "DeleteStaff[[.Record]]User", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "RenameStaff[[.Record]]User", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "SetStaff[[.Record]]UserName", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "SetStaff[[.Record]]UserEmail", "managedHere = true")
[[- if .Password]]
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "RequireStaff[[.Record]]PasswordChange", "managedHere = true")
[[- end]]
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "RevokeStaff[[.Record]]UserTrustedDevices", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "EndStaff[[.Record]]UserSessions", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "UnlinkStaff[[.Record]]SessionIdentity", "managedHere = true")
[[- if .Password]]
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "RemoveStaff[[.Record]]Password", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "List", "Staff[[.Record]]SignInWays", "managedHere = true")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "SendStaff[[.Record]]UserPasswordResetLink", "managedHere = true OR managedByAnotherDirectory = false")
[[- end]]
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "RemoveStaff[[.Record]]Role", "everyDomain = false")
	provesGrant(t, staff.Roles(), "[[.Record]]Administrator", "Execute", "WithdrawStaff[[.Record]]Invitation", "pending = true")
[[- if .Administrator]]
	// And the application's own administrator's, on the whole application's twin of each
	// method above that acts on an account.
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "DisableStaffUser", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "EnableStaffUser", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "DeleteStaffUser", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "RenameStaffUser", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "SetStaffUserName", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "SetStaffUserEmail", "managedByTenant = false")
[[- if .Password]]
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "RequireStaffPasswordChange", "managedByTenant = false")
[[- end]]
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "RevokeStaffUserTrustedDevices", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "EndStaffUserSessions", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "UnlinkStaffSessionIdentity", "managedByTenant = false")
[[- if .Password]]
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "RemoveStaffPassword", "managedByTenant = false")
	provesGrant(t, staff.Roles(), "[[.Administrator]]", "Execute", "SendStaffUserPasswordResetLink", "managedByTenant = false")
[[- end]]
[[- end]]

	// south is the development seed's second tenant, by the id the seed gives it.
	const south = "[[.South]]"

	ctx := t.Context()
	s := newServed(ctx, t)
	admin, member := tenantAdministrators(ctx, t, s)

	// The three have accounts already (staffAccount), and the application's
	// administrator gives each a role in north; then sam a role in south and gail one of
	// the whole application. A tenant's own method gives a role to a person the tenant
	// already holds, so every one of these goes through the whole application's method,
	// which names the tenant, and the person by the id of their account as every method
	// does.
[[- if .OneTenant]] erin has an account with them, and is given the tenants' role in
	// every tenant.
[[- end]]
	ids := map[string]string{}
	for _, name := range []string{"nora", "sam", "gail"[[if .OneTenant]], "erin"[[end]]} {
		ids[name] = staffAccount(ctx, t, s, name, "  "+name+" of north ")
		if status, body := admin.do(ctx, http.MethodPost, "/api/assign-staff-role", []byte(`{"userId":"`+ids[name]+`","role":"[[.Record]]Administrator","domain":"`+north+`"}`)); status != http.StatusNoContent {
			t.Fatalf("giving %s a role in %s: status %d: %s", name, north, status, body)
		}
	}
	globalRole := func(name string) []byte {
		return []byte(`{"userId":"` + ids[name] + `","role":"FeatureAdministrator","everyDomain":false}`)
	}
[[- if .OneTenant]]
	if status, body := admin.do(ctx, http.MethodPost, "/api/assign-staff-role", globalRole("sam")); status != http.StatusNoContent {
		t.Fatalf("giving sam a role of the whole application: status %d: %s", status, body)
	}
[[- end]]
	if status, body := admin.do(ctx, http.MethodPost, "/api/assign-staff-role", []byte(`{"userId":"`+ids["sam"]+`","role":"[[.Record]]Administrator","domain":"`+south+`"}`)); status != http.StatusNoContent {
		t.Fatalf("giving sam a role in %s: status %d: %s", south, status, body)
	}
	if status, body := admin.do(ctx, http.MethodPost, "/api/assign-staff-role", globalRole("gail")); status != http.StatusNoContent {
		t.Fatalf("giving gail a role of the whole application: status %d: %s", status, body)
	}
[[- if .OneTenant]]
	// A role held in every tenant is one membership that no tenant owns, and it is no
	// role of the whole application: erin is held outside north and not globally.
	if status, body := admin.do(ctx, http.MethodPost, "/api/assign-staff-role", []byte(`{"userId":"`+ids["erin"]+`","role":"[[.Record]]Administrator","everyDomain":true}`)); status != http.StatusNoContent {
		t.Fatalf("giving erin a role in every tenant: status %d: %s", status, body)
	}
[[- end]]
	// sam is one of south's people now, as its administrator reads them; and south is
	// no tenant north's administrator reaches: holding nothing there, they are answered
	// as if it did not exist.
	if row := tenantRows(ctx, t, admin, south, "staff-[[.Kebab]]-users")[ids["sam"]]; row["username"] != "sam" {
		t.Fatalf("sam among south's people = %v, want the account that holds a role in north too", row)
	}
	if status, body := tenantPost(ctx, member, south, "disable-staff-[[.Kebab]]-user", map[string]any{"userId": ids["sam"]}); status != http.StatusNotFound {
		t.Fatalf("north's administrator calling a method of south's: status %d, want 404: %s", status, body)
	}
	// One identity link each, written as a directory sign-in writes one.
	links := map[string]string{}
	linkRows := make([]*spanner.Mutation, 0, len(ids))
	for name, userID := range ids {
		id, err := impulse.NewUUID()
		if err != nil {
			t.Fatalf("impulse.NewUUID() error = %v", err)
		}
		links[name] = id.String()
		linkRows = append(linkRows, spanner.InsertMap("StaffSessionIdentities", map[string]any{
			"Id": id.String(), "UserId": userID, "Method": "google", "Connection": "example.com", "Subject": "subject-of-" + name,
			"EmailAtLink": name + "@example.com", "CreatedAt": spanner.CommitTimestamp, "LastUsedAt": spanner.CommitTimestamp,
		}))
	}
[[- if .Password]]
	// And a second one for nora, of another directory account, so that she keeps a way in
	// when the first link goes and, where a link signs a person in, when her password
	// does.
	second, err := impulse.NewUUID()
	if err != nil {
		t.Fatalf("impulse.NewUUID() error = %v", err)
	}
	linkRows = append(linkRows, spanner.InsertMap("StaffSessionIdentities", map[string]any{
		"Id": second.String(), "UserId": ids["nora"], "Method": "google", "Connection": "example.com", "Subject": "second-subject-of-nora",
		"EmailAtLink": "nora@example.com", "CreatedAt": spanner.CommitTimestamp, "LastUsedAt": spanner.CommitTimestamp,
	}))
[[- if .Administrator]]
	// And one for gail, for the same reason: the application's administrator makes the
	// same calls for her at the end that north makes for nora.
	gailSecond, err := impulse.NewUUID()
	if err != nil {
		t.Fatalf("impulse.NewUUID() error = %v", err)
	}
	linkRows = append(linkRows, spanner.InsertMap("StaffSessionIdentities", map[string]any{
		"Id": gailSecond.String(), "UserId": ids["gail"], "Method": "google", "Connection": "example.com", "Subject": "second-subject-of-gail",
		"EmailAtLink": "gail@example.com", "CreatedAt": spanner.CommitTimestamp, "LastUsedAt": spanner.CommitTimestamp,
	}))
[[- end]]
[[- end]]
	if _, err := s.db.Apply(ctx, linkRows); err != nil {
		t.Fatalf("writing the identity links: %v", err)
	}

	// The rest of a person's account is answered where north manages it: for nora alone.
	// The address is answered for everyone in the list, as the name is. gail holds a role
	// of the whole application, so the application's administrators manage her account,
	// and its rest is not north's to read, as sam's is not.
[[- if .OneTenant]] erin's role in every
	// tenant is held outside north, so her account is no tenant's either.
[[- end]] The identities a
	// person signs in with are read under the same condition: north lists nora's, and no
	// identity of the others, whose links it does not find.
	for name, managed := range map[string]bool{"nora": true, "gail": false, "sam": false[[if .OneTenant]], "erin": false[[end]]} {
		northsPeople := tenantRows(ctx, t, member, north, "staff-[[.Kebab]]-users")
		for where, row := range map[string]map[string]any{
			"list": northsPeople[ids[name]],
			"read": tenantRow(ctx, t, member, north, "staff-[[.Kebab]]-users", ids[name]),
		} {
			if row["username"] != name {
				t.Errorf("%s: the %s of north's people answers %v, want the person with the fields the grant carries with no condition", name, where, row)
			}
			// The name the account was created with, without the space around it: shown
			// for every person of the tenant, as the username is.
			if row["name"] != name+" of north" {
				t.Errorf("%s: the name in the %s = %v, want %q", name, where, row["name"], name+" of north")
			}
			if _, got := row["email"]; !got {
				t.Errorf("%s: the address in the %s is not answered, and it is for everyone in the list: %v", name, where, row)
			}
			if _, got := row["createdAt"]; got != managed {
				t.Errorf("%s: the date the account was created, in the %s, is answered = %v, want %v: %v", name, where, got, managed, row)
			}
		}
		identities := tenantRows(ctx, t, member, north, "staff-[[.Kebab]]-identities")
		if !managed {
			if row, listed := identities[links[name]]; listed {
				t.Errorf("%s: north lists the identity of a person whose account it does not manage: %v", name, row)
			}
			if status, body := member.do(ctx, http.MethodGet, "/api/[[.Segment]]/"+north+"/staff-[[.Kebab]]-identities/"+links[name], nil); status != http.StatusNotFound {
				t.Errorf("%s: north's read of the identity: status %d, want 404: %s", name, status, body)
			}

			continue
		}
		for where, row := range map[string]map[string]any{
			"list": identities[links[name]],
			"read": tenantRow(ctx, t, member, north, "staff-[[.Kebab]]-identities", links[name]),
		} {
			if row["method"] != "google" || row["subject"] != "subject-of-"+name {
				t.Errorf("%s: the %s of north's identities answers %v, want the link with its method and the directory's subject", name, where, row)
			}
		}
	}
[[if .Password]]
	// Whether the identity each person was given can sign them in is the auth's to say:
	// it can where the login page offers a sign-in through that directory, and it cannot
	// in an application whose login page offers the password alone. The list of how a
	// person signs in and the removal of a password are both judged by it.
	linkSignsIn := len(s.auth.Session().API().SignsInThrough(sessioninfo.MethodGoogle, "example.com")) > 0

	// How a person signs in is read under the same condition as the rest of the account:
	// north lists nora's password and, where it signs her in, her identity, and nothing
	// of a person whose account it does not manage. A page that offers the removal of a
	// password by these rows offers none for them.
	for name, managed := range map[string]bool{"nora": true, "gail": false, "sam": false[[if .OneTenant]], "erin": false[[end]]} {
		ways := tenantWays(ctx, t, member, north, ids[name])
		if !managed {
			if len(ways) != 0 {
				t.Errorf("%s: north reads how a person whose account it does not manage signs in: %v", name, ways)
			}

			continue
		}
		if _, got := ways["password"]; !got {
			t.Errorf("%s: the ways north reads leave out the password: %v", name, ways)
		}
		if _, got := ways[links[name]]; got != linkSignsIn {
			t.Errorf("%s: the identity among the ways north reads = %v, want %v, since the list holds the identities that can sign a person in: %v", name, got, linkSignsIn, ways)
		}
	}

	// A password reset link goes to a person whose account the tenant does not manage
	// too, unless another tenant's directory manages it: north and south each send one
	// to sam, whom both hold, once the address is one sam confirmed.
	if _, err := s.db.Apply(ctx, []*spanner.Mutation{spanner.UpdateMap("StaffSessionUsers", map[string]any{"Id": ids["sam"], "EmailVerifiedAt": spanner.CommitTimestamp})}); err != nil {
		t.Fatalf("confirming sam's address: %v", err)
	}
	for _, by := range []struct {
		who    string
		b      *browser
		tenant string
	}{{"north's administrator", member, north}, {"the administrator of every tenant, in south", admin, south}} {
		if status, body := tenantPost(ctx, by.b, by.tenant, "send-staff-[[.Kebab]]-user-password-reset-link", map[string]any{"userId": ids["sam"]}); status != http.StatusOK {
			t.Errorf("%s sending sam a reset link: status %d, want 200: %s", by.who, status, body)
		}
	}
[[end]]
	// The methods that act on an account, each with the body it takes and the answer it
	// gives for a person whose account north manages.
	user := func(name string) map[string]any {
		return map[string]any{"userId": ids[name]}
	}
	accountMethods := []struct {
		method string
		body   func(name string) map[string]any
		want   int
	}{
		{"set-staff-[[.Kebab]]-user-name", func(name string) map[string]any {
			return map[string]any{"userId": ids[name], "name": name + " renamed"}
		}, http.StatusNoContent},
		// The method that asks for a new address answers how its mailing went.
		{"set-staff-[[.Kebab]]-user-email", func(name string) map[string]any {
			return map[string]any{"userId": ids[name], "email": name + ".new@example.com"}
		}, http.StatusOK},
		{"rename-staff-[[.Kebab]]-user", func(name string) map[string]any {
			return map[string]any{"userId": ids[name], "username": name + "-renamed"}
		}, http.StatusNoContent},
[[- if .Password]]
		{"require-staff-[[.Kebab]]-password-change", user, http.StatusNoContent},
[[- end]]
		{"end-staff-[[.Kebab]]-user-sessions", user, http.StatusNoContent},
		{"revoke-staff-[[.Kebab]]-user-trusted-devices", user, http.StatusNoContent},
		{"disable-staff-[[.Kebab]]-user", user, http.StatusNoContent},
		{"enable-staff-[[.Kebab]]-user", user, http.StatusNoContent},
[[- if .Password]]
		// A person keeps one way in: an identity is unlinked while a password is held, and
		// a password removed while an identity that signs them in is linked. So the link
		// goes first, while the password stands, and the second link written above is
		// what lets the password go after it. Where a link signs nobody in, the removal
		// is north's to ask for and that rule refuses it: the grant let the call reach
		// the rule, which is what the condition decides.
		{"unlink-staff-[[.Kebab]]-session-identity", func(name string) map[string]any {
			return map[string]any{"identityId": links[name]}
		}, http.StatusNoContent},
		{"remove-staff-[[.Kebab]]-password", user, passwordRemoval(linkSignsIn)},
[[- else]]
		// A person keeps one way in, and nobody here holds a password: the one identity
		// linked to a person is their only way in, so its unlinking is north's to ask
		// for and that rule refuses it. The grant let the call reach the rule, which is
		// what the condition decides: the same call for sam or gail never gets there.
		{"unlink-staff-[[.Kebab]]-session-identity", func(name string) map[string]any {
			return map[string]any{"identityId": links[name]}
		}, http.StatusConflict},
[[- end]]
		{"delete-staff-[[.Kebab]]-user", user, http.StatusNoContent},
	}

	// An account north does not manage is not north's to change: every method is refused
	// for sam and for gail.
[[- if .OneTenant]] sam and gail hold a role
	// of the whole application, which refuses them whatever else they hold; erin holds
	// none, so what refuses every method for her is the role she holds in every tenant.
[[- end]]
	for _, m := range accountMethods {
		for _, name := range []string{"sam", "gail"[[if .OneTenant]], "erin"[[end]]} {
			if status, body := tenantPost(ctx, member, north, m.method, m.body(name)); status != http.StatusForbidden {
				t.Errorf("%s on %s: status %d, want 403: %s", m.method, name, status, body)
			}
		}
	}
	// Nothing a refused call asked for was done: both are listed as they were, by the
	// name they were created with, and their links stand.
[[- if .OneTenant]] So is erin.
[[- end]]
	northsPeople := tenantRows(ctx, t, member, north, "staff-[[.Kebab]]-users")
	for _, name := range []string{"sam", "gail"[[if .OneTenant]], "erin"[[end]]} {
		if row := northsPeople[ids[name]]; row["username"] != name || row["name"] != name+" of north" || row["disabled"] != false {
			t.Errorf("%s after the refused calls = %v, want the account as it was", name, row)
		}
		if _, err := s.db.Single().ReadRow(ctx, "StaffSessionIdentities", spanner.Key{links[name]}, []string{"Id"}); err != nil {
			t.Errorf("%s's identity link after the refused calls: %v, want it kept", name, err)
		}
	}
[[- if .Administrator]]

	// Nor is an account north manages the application's to change: the application's own
	// administrator is refused every method for nora through the whole application's
	// route[[if .Password]], and the reset link too[[end]]. What north then does for her
	// shows that nothing a refused call asked for was done.
	for _, m := range accountMethods {
		if status, body := applicationPost(ctx, admin, m.method, m.body("nora")); status != http.StatusForbidden {
			t.Errorf("%s on nora: status %d, want 403: %s", applicationRoute(m.method), status, body)
		}
	}
[[- if .Password]]
	if status, body := applicationPost(ctx, admin, "send-staff-[[.Kebab]]-user-password-reset-link", user("nora")); status != http.StatusForbidden {
		t.Errorf("the application's administrator sending nora a reset link: status %d, want 403: %s", status, body)
	}
[[- end]]
[[- end]]

	// An account north manages is north's to change: every method is north's to call
	// for nora, in the order above, and answers as the method does.
	for _, m := range accountMethods {
		if status, body := tenantPost(ctx, member, north, m.method, m.body("nora")); status != m.want {
			t.Fatalf("%s on nora: status %d, want %d: %s", m.method, status, m.want, body)
		}
	}
	// The last of the methods deleted the account.
	if row, listed := tenantRows(ctx, t, member, north, "staff-[[.Kebab]]-users")[ids["nora"]]; listed {
		t.Errorf("nora is still one of north's people after the delete: %v", row)
	}

	// A role held in every tenant is not one tenant's to take. The application's
	// administrator holds [[.Record]]Administrator in every tenant: one membership, which
	// north's list of the roles held shows and north does not own.
	if status, body := tenantPost(ctx, member, north, "remove-staff-[[.Kebab]]-role", map[string]any{"userId": s.adminID, "role": "[[.Record]]Administrator"}); status != http.StatusForbidden {
		t.Errorf("north taking a role held in every tenant: status %d, want 403: %s", status, body)
	}
	if roles := tenantRolesOf(ctx, t, member, north, adminUser); len(roles) != 1 {
		t.Errorf("the administrator's roles in north after the refusal = %v, want the one held in every tenant", roles)
	}
	// A role held in north itself is north's to take, whatever else the person holds:
	// sam keeps the account and the role in south.
	if status, body := tenantPost(ctx, member, north, "remove-staff-[[.Kebab]]-role", map[string]any{"userId": ids["sam"], "role": "[[.Record]]Administrator"}); status != http.StatusNoContent {
		t.Fatalf("north taking the role sam holds in north: status %d, want 204: %s", status, body)
	}
	if roles := tenantRolesOf(ctx, t, member, north, "sam"); len(roles) != 0 {
		t.Errorf("sam's roles in north after the role was taken = %v, want none", roles)
	}
	if roles := tenantRolesOf(ctx, t, admin, south, "sam"); len(roles) != 1 {
		t.Errorf("sam's roles in south = %v, want the one given there", roles)
	}

	// An invitation is withdrawn while it stands.
	status, body := tenantPost(ctx, member, north, "invite-staff-[[.Kebab]]-user", map[string]any{"email": "regret@example.com", "roles": []string{"[[.Record]]Administrator"}})
	if status != http.StatusOK {
		t.Fatalf("inviting into north: status %d: %s", status, body)
	}
	var invitation struct {
		ID string `json:"id"`
	}
	if err := json.Unmarshal(body, &invitation); err != nil || invitation.ID == "" {
		t.Fatalf("the invitation answered %s (%v), want its id", body, err)
	}
	withdraw := map[string]any{"invitationId": invitation.ID}
	if status, body := tenantPost(ctx, member, north, "withdraw-staff-[[.Kebab]]-invitation", withdraw); status != http.StatusNoContent {
		t.Fatalf("withdrawing the invitation: status %d, want 204: %s", status, body)
	}
	// Withdrawn, it stands no more, and the grant no longer reaches it.
	if status, body := tenantPost(ctx, member, north, "withdraw-staff-[[.Kebab]]-invitation", withdraw); status != http.StatusForbidden {
		t.Errorf("withdrawing it a second time: status %d, want 403: %s", status, body)
	}
[[- if .Administrator]]

	// gail holds a role of the whole application beside the one in north, so no tenant
	// manages her account, and it is the application's own administrator's to change:
[[- if .Password]]
	// the reset link goes to her once her address is one she confirmed, and every method
	// answers for her what it answered for nora, the last deleting the account.
	if _, err := s.db.Apply(ctx, []*spanner.Mutation{spanner.UpdateMap("StaffSessionUsers", map[string]any{"Id": ids["gail"], "EmailVerifiedAt": spanner.CommitTimestamp})}); err != nil {
		t.Fatalf("confirming gail's address: %v", err)
	}
	if status, body := applicationPost(ctx, admin, "send-staff-[[.Kebab]]-user-password-reset-link", user("gail")); status != http.StatusOK {
		t.Errorf("the application's administrator sending gail a reset link: status %d, want 200: %s", status, body)
	}
[[- else]]
	// every method answers for her what it answered for nora, the last deleting the
	// account.
[[- end]]
	for _, m := range accountMethods {
		if status, body := applicationPost(ctx, admin, m.method, m.body("gail")); status != m.want {
			t.Fatalf("%s on gail: status %d, want %d: %s", applicationRoute(m.method), status, m.want, body)
		}
	}
	if row, listed := tenantRows(ctx, t, member, north, "staff-[[.Kebab]]-users")[ids["gail"]]; listed {
		t.Errorf("gail is still one of north's people after the delete: %v", row)
	}
[[- end]]
}
[[if .Password]]
// TestTenantPeople_aResetLinkGoesToEveryoneButAPersonAnotherTenantsDirectoryManages
// proves each half of the condition on a tenant administrator's grant to send a
// password reset link (managedHere = true OR managedByAnotherDirectory = false), on the
// condition itself.
//
// The served test above sends one to a person the tenant does not manage, whom two
// tenants hold. Nobody there signs in through a tenant's directory, so no request shows
// the half that refuses: a person another tenant's directory manages. So the grant is read from the role file and judged the
// way the method judges the person's row, over the rows of the three kinds of person.
func TestTenantPeople_aResetLinkGoesToEveryoneButAPersonAnotherTenantsDirectoryManages(t *testing.T) {
	t.Parallel()

	sent := resetLinkCondition(t)
	for row, tt := range map[string]struct{ managedHere, managedByAnotherDirectory, want bool }{
		"a person whose account the tenant manages":             {true, false, true},
		"a person nobody's directory manages, held elsewhere too": {false, false, true},
		"a person another tenant's directory manages":           {false, true, false},
	} {
		truth, err := condition.Evaluate(sent, &condition.Image{Pre: map[string]any{"managedHere": tt.managedHere, "managedByAnotherDirectory": tt.managedByAnotherDirectory}})
		if err != nil {
			t.Fatalf("judging %s: %v", row, err)
		}
		if truth.Permits() != tt.want {
			t.Errorf("the tenant's administrator sends a reset link to %s = %v, want %v", row, truth.Permits(), tt.want)
		}
	}
}

// resetLinkCondition reads, from the role file, the condition on the tenant
// administrator's grant to send a password reset link, parsed as the engine parses it.
func resetLinkCondition(t *testing.T) condition.Expr {
	t.Helper()

	parsed, err := staff.Roles().Parse()
	if err != nil {
		t.Fatalf("parsing the role file: %v", err)
	}
	for _, r := range slices.Concat(parsed.Roles.Global, parsed.Roles.Domain) {
		if r.Name != "[[.Record]]Administrator" {
			continue
		}
		for _, g := range r.Permissions["Execute"] {
			if g.Resource != "SendStaff[[.Record]]UserPasswordResetLink" {
				continue
			}
			expr, err := condition.Parse(g.Condition)
			if err != nil {
				t.Fatalf("parsing the condition %q: %v", g.Condition, err)
			}

			return expr
		}
	}
	t.Fatal("the role file grants the tenant's administrator no reset link to send")

	return nil
}
[[end]]
// tenantAdministrators returns two signed-in browsers: the development login's, holding
// [[.Record]]Administrator in every tenant as a deployment's first administrator does, and
// that of north's administrator, an account the stack is given here that holds the role
// in north and nothing else.
[[- if .Password]] The harness gives its logins one password, so the
// account takes it too.
[[- else]] Nobody here holds a password, so the account is a persona of
// a cast the suite seeds beside the auth's own, as the cast's persona is.
[[- end]] The engine's
// snapshot swap is asynchronous, so each role is waited for before anybody signs in.
func tenantAdministrators(ctx context.Context, t *testing.T, s *served) (admin, member *browser) {
	t.Helper()
[[if .Password]]
	password := adminPassword
	id, err := s.auth.Session().API().CreateSessionUser(ctx, &session.CreateUserRequest{Username: memberUser, Password: &password})
	if err != nil {
		t.Fatalf("CreateSessionUser(%s) error = %v", memberUser, err)
	}
	memberID := id.String()
[[- else]]
	if _, err := s.auth.SeedCastFile(ctx, io.Discard, []byte(`{"personas": [{"login": "`+memberUser+`", "name": "North's Administrator", "email": "`+memberUser+`@example.com"}]}`)); err != nil {
		t.Fatalf("staff.Auth.SeedCastFile(%s) error = %v", memberUser, err)
	}
	memberID := session.SeedUserID(staff.Name, memberUser).String()
[[- end]]
	holders := []struct {
		user  string
		scope accesstypes.PolicyScope
	}{
		{s.adminID, accesstypes.EveryDomainPolicyScope()},
		{memberID, accesstypes.DomainPolicyScope(north)},
	}
	for _, h := range holders {
		if err := s.access.UserManager().AddUserRoles(ctx, h.scope, accesstypes.User(h.user), "[[.Record]]Administrator"); err != nil {
			t.Fatalf("AddUserRoles(%s, %v) error = %v", h.user, h.scope, err)
		}
	}
	for _, h := range holders {
		if d := decisionFor(ctx, t, s.access.ForUser(accesstypes.User(h.user)), accesstypes.DomainScope(north), accesstypes.List, "Staff[[.Record]]UserRoles", time.Now().Add(15*time.Second)); !d.IsGranted() {
			t.Fatalf("List on Staff[[.Record]]UserRoles in north for %s = %s, want granted before anybody signs in", h.user, d)
		}
	}
	admin, member = newBrowser(t, s), newBrowser(t, s)
[[- if .Password]]
	admin.signIn(ctx, adminUser)
	member.signIn(ctx, memberUser)
[[- else]]
	admin.signIn(ctx, staff.PersonaRegistration, adminUser)
	member.signIn(ctx, staff.PersonaRegistration, memberUser)
[[- end]]

	return admin, member
}


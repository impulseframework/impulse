// tenantPost calls a method of the tenant's as the browser b, with the body as JSON.
func tenantPost(ctx context.Context, b *browser, tenant, method string, body map[string]any) (status int, respBody []byte) {
	b.t.Helper()

	encoded, err := json.Marshal(body)
	if err != nil {
		b.t.Fatal(err)
	}

	return b.do(ctx, http.MethodPost, "/api/[[.Segment]]/"+tenant+"/"+method, encoded)
}
[[if .Administrator]]
// applicationPost calls the whole application's twin of a method of the tenant's as the
// browser b, with the body as JSON (applicationRoute).
func applicationPost(ctx context.Context, b *browser, method string, body map[string]any) (status int, respBody []byte) {
	b.t.Helper()

	encoded, err := json.Marshal(body)
	if err != nil {
		b.t.Fatal(err)
	}

	return b.do(ctx, http.MethodPost, applicationRoute(method), encoded)
}

// applicationRoute is the route of the whole application's twin of a method of the
// tenant's: the tenant's method with the record taken out, outside the tenant's routes.
func applicationRoute(method string) string {
	return "/api/" + strings.Replace(method, "-[[.Kebab]]-", "-", 1)
}

package integration

import (
	"context"
	"encoding/json"
	"net/http"
	"slices"
	"testing"

	"github.com/impulseframework/impulse/accesstypes"
	"github.com/impulseframework/impulse/session/sessioninfo"

	"github.com/impulseframework/impulse/cmd/impulse/internal/skeleton/_candidates/solo/pkg/auth/staff"
)

// TestLogin drives the served stack the way the console does: sign in through a
// registration of the auth, read the session, read the permission digest. Nobody has a
// password. The cast's persona signs in through the persona registration, the sign-in of
// the test environments, and holds what the cast gives them; a persona the cast does not
// name, and a person of a directory that is no tenant's who holds no invitation, are
// refused, with no account made for them.
func TestLogin(t *testing.T) {
	t.Parallel()

	ctx := t.Context()
	s := newServed(ctx, t)

	tests := []struct {
		name         string
		registration string
		user         string
		// wantRefused is the reason the login page is told, where the sign-in is refused.
		wantRefused sessioninfo.LoginRefusalCode
		wantDigest  int
	}{
		{name: "the cast's persona signs in and reads their digest", registration: staff.PersonaRegistration, user: adminUser, wantDigest: http.StatusOK},
		{name: "a persona the cast does not name is refused and the digest stays closed", registration: staff.PersonaRegistration, user: "understudy", wantRefused: sessioninfo.RefusedNotInvited, wantDigest: http.StatusUnauthorized},
		{name: "a person of a Google Workspace that is no tenant's directory, with no invitation, is refused", registration: staff.GoogleRegistration, user: "mallory@lakeside.example", wantRefused: sessioninfo.RefusedNotInvited, wantDigest: http.StatusUnauthorized},
		{name: "a person of a Microsoft Entra tenant that is no tenant's directory, with no invitation, is refused", registration: staff.AzureRegistration, user: "mallory@harbor.example", wantRefused: sessioninfo.RefusedNotInvited, wantDigest: http.StatusUnauthorized},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			t.Parallel()

			b := newBrowser(t, s)

			// The first request primes the XSRF cookie the session middleware issues.
			if status, body := b.do(ctx, http.MethodGet, "/api/user/session", nil); status != http.StatusOK {
				t.Fatalf("GET /api/user/session before login: status %d: %s", status, body)
			}

			if tt.wantRefused == "" {
				b.signIn(ctx, tt.registration, tt.user)
			} else if status, location := b.directoryRoundTrip(ctx, tt.registration, tt.user); status != http.StatusFound || location != "/login?code="+string(tt.wantRefused) {
				t.Fatalf("the sign-in through the %s registration: status %d to %q, want %d to the login page naming %s", tt.registration, status, location, http.StatusFound, tt.wantRefused)
			}

			sess := b.session(ctx)
			if sess.Authenticated != (tt.wantRefused == "") {
				t.Errorf("authenticated = %v, want %v", sess.Authenticated, tt.wantRefused == "")
			}
			if sess.Authenticated && sess.Username != tt.user {
				t.Errorf("the session is %s's, want %s's", sess.Username, tt.user)
			}

			status, body := b.do(ctx, http.MethodGet, "/api/permission-digest", nil)
			if status != tt.wantDigest {
				t.Fatalf("GET /api/permission-digest: status %d, want %d: %s", status, tt.wantDigest, body)
			}
			if status == http.StatusOK {
				var digest accesstypes.PermissionDigest
				if err := json.Unmarshal(body, &digest); err != nil {
					t.Fatalf("digest is not a PermissionDigest: %v: %s", err, body)
				}
			}
		})
	}
}

// TestLoginMethods proves what the login page is offered to draw: the methods route
// answers the two directory methods the auth registers, Google then Microsoft, and no
// password method. A development run, whose stack names the persona provider, lists the
// persona method after them; a deployed environment that names none does not, so its
// login page shows two buttons. Nobody signs in, so the test runs under either build.
func TestLoginMethods(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name  string
		stack func(ctx context.Context, t *testing.T) *served
		want  []string
	}{
		{name: "a deployed environment that names no persona provider", stack: newDeployed, want: []string{"google", "azure"}},
		{name: "a development run", stack: newServed, want: []string{"google", "azure", "persona"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			t.Parallel()

			ctx := t.Context()
			b := newBrowser(t, tt.stack(ctx, t))
			status, body := b.do(ctx, http.MethodGet, "/api/user/methods", nil)
			if status != http.StatusOK {
				t.Fatalf("GET /api/user/methods: status %d: %s", status, body)
			}
			var answer struct {
				Methods []struct {
					Name   string `json:"name"`
					Method string `json:"method"`
					Kind   string `json:"kind"`
				} `json:"methods"`
			}
			if err := json.Unmarshal(body, &answer); err != nil {
				t.Fatalf("the methods answer is not an object: %v: %s", err, body)
			}
			names := make([]string, 0, len(answer.Methods))
			for _, m := range answer.Methods {
				names = append(names, m.Name)
				if m.Method == "password" || m.Kind == "password" {
					t.Errorf("the methods answer offers a password method: %+v", m)
				}
			}
			if !slices.Equal(names, tt.want) {
				t.Errorf("the methods answer names %q, want %q", names, tt.want)
			}
		})
	}
}

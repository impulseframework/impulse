// TestFirstAdministrator_invitedThroughADirectory proves the first administrator of a
// deployed environment comes in through a directory, since nobody of the staff auth has a
// password. Its google registration admits any Google Workspace, so nothing about the
// method says which organization the first administrator signs in from; the invitation
// mailed to the address the placement names does. Another person of the same directory
// who signs in first gets nothing: without the link they are a stranger, refused as not
// invited (the directory is no tenant's), and with the link the invitation is for another
// address. Neither makes an account, and the invitation stands. The invited person
// follows the link, signs in through Google, and holds the Super Administrator role and
// the first administrator's roles.
func TestFirstAdministrator_invitedThroughADirectory(t *testing.T) {
	t.Parallel()

	ctx := t.Context()
	s := newServed(ctx, t)

	const invitedAddress, other = "ada@lakeside.example", "mallory@lakeside.example"
	inviteAdministrator(ctx, t, s, invitedAddress)

	// Another person of the directory, with no link: a stranger, and no account is made.
	stranger := newBrowser(t, s)
	if status, body := stranger.do(ctx, http.MethodGet, "/api/user/session", nil); status != http.StatusOK {
		t.Fatalf("GET /api/user/session before the sign-in: status %d: %s", status, body)
	}
	if status, location := stranger.directoryRoundTrip(ctx, staff.GoogleRegistration, other); status != http.StatusFound || location != "/login?code="+string(sessioninfo.RefusedNotInvited) {
		t.Errorf("another person of the directory signing in first, with no link: status %d to %q, want %d to the login page naming %s", status, location, http.StatusFound, sessioninfo.RefusedNotInvited)
	}

	// The same person with the link, read from the mail the staff auth sent: the
	// invitation is for another address.
	token := mailedInvitation(t, s, invitedAddress)
	stranger = newBrowser(t, s)
	if status, page := showInvitation(ctx, t, stranger, token); status != http.StatusOK {
		t.Fatalf("opening the invitation as another person: status %d: %v", status, page)
	}
	if status, location := stranger.directoryRoundTrip(ctx, staff.GoogleRegistration, other); status != http.StatusFound || location != "/login?code="+string(sessioninfo.RefusedInvitationAddress) {
		t.Errorf("another person of the directory accepting the first administrator's invitation: status %d to %q, want %d to the login page naming %s", status, location, http.StatusFound, sessioninfo.RefusedInvitationAddress)
	}
	if accountExists(ctx, t, s, other) {
		t.Error("an account was made for the person the invitation was not for")
	}
	if standing, err := s.auth.Session().API().Invitations(ctx); err != nil || len(standing) != 1 || standing[0].Email != invitedAddress {
		t.Fatalf("the invitations that stand after the refused sign-ins = %+v, %v, want the first administrator's alone", standing, err)
	}

	// The invited person: the link, the sign-in through Google, and the second factor
	// every session carries.
	b := newBrowser(t, s)
	if status, page := showInvitation(ctx, t, b, token); status != http.StatusOK {
		t.Fatalf("opening the invitation as the invited person: status %d: %v", status, page)
	}
	if status, location := b.directoryRoundTrip(ctx, staff.GoogleRegistration, invitedAddress); status != http.StatusFound || location != heldForFactor {
		t.Fatalf("the invited person's sign-in through Google: status %d to %q, want %d to the login page's code step", status, location, http.StatusFound)
	}
	b.secondFactor(ctx, invitedAddress)
	if sess := b.session(ctx); !sess.Authenticated || sess.Username != invitedAddress {
		t.Fatalf("session after the acceptance = %+v, want authenticated as %s", sess, invitedAddress)
	}

	// They hold the Super Administrator role and the first administrator's roles, each
	// where it is held, and the invitation is spent.
	user, err := s.auth.Session().API().UserByEmail(ctx, invitedAddress)
	if err != nil {
		t.Fatalf("session.AuthAPI.UserByEmail(%s) error = %v: the acceptance made no account", invitedAddress, err)
	}
	held, err := s.access.UserManager().UserRoles(ctx, accesstypes.User(user.ID.String()))
	if err != nil {
		t.Fatalf("access.UserManager.UserRoles(%s) error = %v", invitedAddress, err)
	}
	global, everyDomain := staff.FirstAdministratorRoles()
	wantGlobal := slices.Sorted(slices.Values(append([]accesstypes.Role{accesstypes.SuperAdministrator}, global...)))
	if got := slices.Sorted(slices.Values(held[accesstypes.GlobalPolicyScope()])); !slices.Equal(got, wantGlobal) {
		t.Errorf("the first administrator's roles for the whole application = %v, want %v", got, wantGlobal)
	}
	if got, want := slices.Sorted(slices.Values(held[accesstypes.EveryDomainPolicyScope()])), slices.Sorted(slices.Values(everyDomain)); !slices.Equal(got, want) {
		t.Errorf("the first administrator's roles in every tenant = %v, want %v", got, want)
	}
	if standing, err := s.auth.Session().API().Invitations(ctx); err != nil || len(standing) != 0 {
		t.Errorf("the invitations that stand after the acceptance = %+v, %v, want none", standing, err)
	}

	// A release after the person accepted invites nobody.
	if after, err := s.auth.InviteAdministrator(ctx, invitedAddress); err != nil || after.Outcome != session.FirstAdministratorRoleHeld {
		t.Errorf("the release after the acceptance = %+v, %v, want nobody invited", after, err)
	}
}

// inviteAdministrator makes the stack what a deployed environment starts from and has
// the release invite its first administrator at the address.
func inviteAdministrator(ctx context.Context, t *testing.T, s *served, address string) {
	t.Helper()

	deployed(ctx, t, s)
	invited, err := s.auth.InviteAdministrator(ctx, address)
	if err != nil {
		t.Fatalf("staff.Auth.InviteAdministrator() error = %v", err)
	}
	if invited.Outcome != session.FirstAdministratorInvited || invited.Email != address {
		t.Fatalf("the first release = %+v, want an invitation mailed to %s", invited, address)
	}
}

// invitedAdministrator has the release invite the first administrator as
// inviteAdministrator does, and answers the token of the link the staff auth mailed to
// the address.
func invitedAdministrator(ctx context.Context, t *testing.T, s *served, address string) string {
	t.Helper()

	inviteAdministrator(ctx, t, s, address)

	return mailedInvitation(t, s, address)
}

// deployed makes the stack what a deployed environment starts from. The suites' stack
// opens with the cast's persona, who holds the Super Administrator role, and whom a
// deployment that names no persona provider never has: the persona's account leaves, so
// nobody of the staff auth holds the role, which is when the migrate command invites the
// first administrator (staff.Auth.InviteAdministrator). Its memberships stay in the
// permission store and name no account any more: a holder who is no account of the auth
// is nobody of it.
func deployed(ctx context.Context, t *testing.T, s *served) {
	t.Helper()

	api := s.auth.Session().API()
	users, err := api.Users(ctx)
	if err != nil {
		t.Fatalf("session.AuthAPI.Users() error = %v", err)
	}
	for _, user := range users {
		if err := api.DeleteSessionUser(ctx, user.ID); err != nil {
			t.Fatalf("session.AuthAPI.DeleteSessionUser(%s) error = %v", user.Username, err)
		}
	}
}

// accountExists reports whether the staff auth holds a user under the username.
func accountExists(ctx context.Context, t *testing.T, s *served, username string) bool {
	t.Helper()

	users, err := s.auth.Session().API().Users(ctx)
	if err != nil {
		t.Fatalf("session.AuthAPI.Users() error = %v", err)
	}

	for _, user := range users {
		if user.Username == username {
			return true
		}
	}

	return false
}

// mailedInvitation reads the token of the last invitation link the staff auth mailed to
// the address.
func mailedInvitation(t *testing.T, s *served, email string) string {
	t.Helper()

	link := regexp.MustCompile(`http://solo\.test/login#invitation=([A-Za-z0-9_-]+)`)
	messages := s.mail.Messages()
	for _, m := range slices.Backward(messages) {
		if !strings.Contains(m.To, email) {
			continue
		}
		if match := link.FindStringSubmatch(m.Text); match != nil {
			return match[1]
		}
	}
	t.Fatalf("no invitation link was mailed to %s (%d messages)", email, len(messages))

	return ""
}

// showInvitation follows a mailed link as a person not signed in does: the browser takes
// its XSRF token, then shows the invitation page what the link is. It answers the status
// and the page as the server describes it, or the refusal's body under "refusal".
func showInvitation(ctx context.Context, t *testing.T, b *browser, token string) (status int, page map[string]any) {
	t.Helper()

	if status, body := b.do(ctx, http.MethodGet, "/api/user/session", nil); status != http.StatusOK {
		t.Fatalf("GET /api/user/session before the invitation: status %d: %s", status, body)
	}
	status, body := b.do(ctx, http.MethodPost, "/api/user/invitation", []byte(`{"token":"`+token+`"}`))
	if status != http.StatusOK {
		return status, map[string]any{"refusal": string(body)}
	}
	if err := json.Unmarshal(body, &page); err != nil {
		t.Fatalf("the invitation page's answer is not an object: %v: %s", err, body)
	}

	return status, page
}

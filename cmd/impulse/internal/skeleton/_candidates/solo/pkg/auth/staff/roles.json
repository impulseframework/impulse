            {
              "resource": "StaffUserRoles",
              "fields": [
                "createdAt",
                "startsAt",
                "endsAt",
                "reason"
              ]
            },
            {
              "resource": "StaffSessionIdentities",
              "fields": [
                "connection",
                "createdAt",
                "emailAtLink",
                "lastUsedAt",
                "method",
                "subject",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSignInWays",
              "fields": [
                "password",
                "method",
                "connection",
                "through"
              ]
            },
            {
              "resource": "StaffSessionTokens",
              "fields": [
                "clientId",
                "createdAt",
                "expiresAt",
                "familyId",
                "kind",
                "lastUsedAt",
                "name",
                "outlet",
                "revokedAt",
                "revokedReason",
                "userId"

{
  "roles": {
    "global": [
      {
        "name": "Administrator",
        "description": "Manages the application's people: creates accounts, invites people, gives and takes roles, and sets temporary passwords.",
        "permissions": {
          "Execute": [
            {
              "resource": "CreateStaffUser"
            },
            {
              "resource": "DisableStaffUser"
            },
            {
              "resource": "EnableStaffUser"
            },
            {
              "resource": "AssignStaffRole"
            },
            {
              "resource": "RemoveStaffRole"
            },
            {
              "resource": "EndStaffSession"
            },
            {
              "resource": "EndStaffUserSessions"
            },
            {
              "resource": "RequireStaffPasswordChange"
            },
            {
              "resource": "UnlinkStaffSessionIdentity"
            },
            {
              "resource": "RevokeStaffSessionToken"
            },
            {
              "resource": "DeleteStaffUser"
            },
            {
              "resource": "RenameStaffUser"
            },
            {
              "resource": "SetStaffTemporaryPassword"
            },
            {
              "resource": "RevokeStaffUserTrustedDevices"
            },
            {
              "resource": "UnlockStaffSignIn"
            },
            {
              "resource": "InviteStaffUser"
            },
            {
              "resource": "WithdrawStaffInvitation"
            },
            {
              "resource": "SetStaffUserEmail"
            }
          ],
          "List": [
            {
              "resource": "StaffSessionUsers",
              "fields": [
                "username",
                "email",
                "emailVerifiedAt",
                "disabled",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ]
            },
            {
              "resource": "StaffSessions",
              "fields": [
                "userId",
                "username",
                "expired",
                "authenticatedAt",
                "createdAt",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffUserRoles",
              "fields": [
                "createdAt"
              ]
            },
            {
              "resource": "StaffSessionIdentities",
              "fields": [
                "connection",
                "createdAt",
                "emailAtLink",
                "lastUsedAt",
                "method",
                "subject",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTokens",
              "fields": [
                "clientId",
                "createdAt",
                "expiresAt",
                "family",
                "kind",
                "lastUsedAt",
                "name",
                "outlet",
                "revokedAt",
                "revokedReason",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionMailLinks",
              "fields": [
                "consumedAt",
                "createdAt",
                "email",
                "expiresAt",
                "invitedBy",
                "kind",
                "roleNames",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionSignInAttempts",
              "fields": [
                "failures",
                "lockedUntil",
                "updatedAt",
                "windowEndsAt"
              ]
            },
            {
              "resource": "StaffSessionAuthEvents",
              "fields": [
                "connection",
                "idpAmr",
                "method",
                "occurredAt"
              ]
            },
            {
              "resource": "StaffRoles",
              "fields": [
                "description",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffRoleGrants",
              "fields": [
                "updatedAt"
              ]
            },
            {
              "resource": "StaffSessionTrustedDevices",
              "fields": [
                "createdAt",
                "expiresAt",
                "lastUsedAt",
                "revokedAt",
                "userId"
              ]
            }
          ],
          "Read": [
            {
              "resource": "StaffSessionUsers",
              "fields": [
                "username",
                "email",
                "emailVerifiedAt",
                "disabled",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ]
            },
            {
              "resource": "StaffSessions",
              "fields": [
                "userId",
                "username",
                "expired",
                "authenticatedAt",
                "createdAt",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffSessionIdentities",
              "fields": [
                "connection",
                "createdAt",
                "emailAtLink",
                "lastUsedAt",
                "method",
                "subject",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTokens",
              "fields": [
                "clientId",
                "createdAt",
                "expiresAt",
                "family",
                "kind",
                "lastUsedAt",
                "name",
                "outlet",
                "revokedAt",
                "revokedReason",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionMailLinks",
              "fields": [
                "consumedAt",
                "createdAt",
                "email",
                "expiresAt",
                "invitedBy",
                "kind",
                "roleNames",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTrustedDevices",
              "fields": [
                "createdAt",
                "expiresAt",
                "lastUsedAt",
                "revokedAt",
                "userId"
              ]
            }
          ]
        }
      },
      {
        "name": "FeatureAdministrator",
        "description": "Turns feature flags on and off for an environment.",
        "permissions": {
          "Execute": [
            {
              "resource": "SetFeature"
            }
          ],
          "List": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ],
          "Read": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ]
        }
      }
    ],
    "domain": []
  }
}

                "createdAt",
                "emailAtLink",
                "lastUsedAt",
                "method",
                "subject",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTokens",
              "fields": [
                "clientId",
                "createdAt",
                "expiresAt",
                "familyId",
                "kind",
                "lastUsedAt",
                "name",
                "outlet",
                "revokedAt",
                "revokedReason",
                "userId"

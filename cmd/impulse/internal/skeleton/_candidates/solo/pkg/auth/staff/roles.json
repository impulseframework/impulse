              "fields": [
                "createdAt",
                "expiresAt",
                "lastUsedAt",
                "revokedAt",
                "userId"
              ]
            },
            {
              "resource": "StaffGroups",
              "fields": [
                "kind",
                "axis",
                "domainId",
                "name",
                "description",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffGroupUsers",
              "fields": [
                "username",
                "name",
                "groupName",
                "createdAt",
                "startsAt",
                "endsAt"
              ]
            },
            {
              "resource": "StaffGroupRoles",
              "fields": [
                "createdAt",
                "startsAt",
                "endsAt"
              ]
            },
            {
              "resource": "StaffUserGroupRoles",

                "username",
                "groupName",
                "startsAt",
                "endsAt"
              ]
            },
            {
              "resource": "StaffHeldRoles",
              "fields": [
                "username",
                "groupName",
                "createdAt",
                "startsAt",
                "endsAt",
                "reason"
              ]
            },
            {
              "resource": "StaffListedGroups",
              "fields": [
                "kind",
                "axis",
                "domainId",
                "name",
                "description",
                "updatedAt",
                "people",
                "roles"
              ]
            },
            {

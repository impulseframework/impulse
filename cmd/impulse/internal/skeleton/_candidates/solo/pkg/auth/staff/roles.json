            {
              "resource": "InviteStaffUser"
            },
            {
              "resource": "WithdrawStaffInvitation"
            },
            {
              "resource": "SetStaffUserEmail"
            },
            {
              "resource": "SetStaffUserName"
            },
            {
              "resource": "CreateStaffGroup"
            },
            {
              "resource": "DescribeStaffGroup"
            },
            {
              "resource": "DeleteStaffGroup"
            },
            {
              "resource": "AddStaffGroupMember"
            },
            {
              "resource": "RemoveStaffGroupMember"
            },
            {
              "resource": "GiveStaffGroupRole"
            },
            {
              "resource": "TakeStaffGroupRole"
            }
          ],
          "List": [
            {
              "resource": "StaffSessionUsers",
              "fields": [
                "username",
                "name",
                "email",
                "emailVerifiedAt",
                "disabled",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ]
            },
            {
              "resource": "StaffSessions",
              "fields": [
                "userId",
                "username",
                "expired",
                "authenticatedAt",
                "createdAt",
                "updatedAt"
              ]

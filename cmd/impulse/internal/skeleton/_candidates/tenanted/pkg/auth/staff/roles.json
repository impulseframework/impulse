    "domain": [
      {
        "name": "TenantAdministrator",
        "description": "Runs one tenant: manages its people, their groups and the roles they hold there, declares the directories they sign in through, and posts its announcements.",
        "permissions": {
          "Create": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "title"
              ]
            },
            {
              "resource": "TenantDirectories"
            }
          ],
          "Delete": [
            {
              "resource": "Announcements"
            },
            {
              "resource": "TenantDirectories"
            }
          ],
          "Execute": [
            {
              "resource": "CreateStaffTenantUser"
            },
            {
              "resource": "InviteStaffTenantUser"
            },
            {
              "resource": "WithdrawStaffTenantInvitation",
              "condition": "pending = true"
            },
            {
              "resource": "AssignStaffTenantRole"
            },
            {
              "resource": "RemoveStaffTenantRole",
              "condition": "everyDomain = false"
            },
            {
              "resource": "DisableStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "EnableStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "DeleteStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RenameStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "SetStaffTenantUserEmail",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "SetStaffTenantUserName",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "SetStaffTenantTemporaryPassword",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RequireStaffTenantPasswordChange",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RevokeStaffTenantUserTrustedDevices",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "EndStaffTenantUserSessions",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "UnlinkStaffTenantSessionIdentity",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RemoveStaffTenantPassword",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "CreateStaffTenantGroup"
            },
            {
              "resource": "DescribeStaffTenantGroup"
            },
            {
              "resource": "DeleteStaffTenantGroup"
            },
            {
              "resource": "AddStaffTenantGroupMember"
            },
            {
              "resource": "RemoveStaffTenantGroupMember"
            },
            {
              "resource": "GiveStaffTenantGroupRole"
            },
            {
              "resource": "TakeStaffTenantGroupRole"
            },
            {
              "resource": "MakeTenantDirectoryOnly"
            },
            {
              "resource": "EndTenantDirectoryOnly"
            },
            {
              "resource": "OpenTenantToDirectory"
            },
            {
              "resource": "MakeTenantInviteOnly"
            }
          ],
          "List": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "TenantDirectories",
              "fields": [
                "connection",
                "defaultSeat",
                "method",
                "tenantId"
              ]
            },
            {
              "resource": "StaffTenantUsers",
              "fields": [
                "username",
                "name",
                "disabled",
                "createdAt",
                "lastSignInAt",
                "heldElsewhere",
                "heldGlobally",
                "cannotEnter"
              ]
            },
            {
              "resource": "StaffTenantUsers",
              "fields": [
                "email",
                "emailVerifiedAt",
                "passwordChangeRequired"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "StaffTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt",
                "startsAt",
                "endsAt",
                "reason"
              ]
            },
            {
              "resource": "StaffTenantInvitations",
              "fields": [
                "email",
                "name",
                "roleNames",
                "invitedByUserId",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "pending"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "tenant",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "subject",
                "emailAtLink"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "StaffTenantSignInWays",
              "fields": [
                "password",
                "method",
                "connection",
                "through",
                "heldElsewhere",
                "heldGlobally"
              ],
              "condition": "password = false OR heldElsewhere = false"
            },
            {
              "resource": "StaffTenantRoles",
              "fields": [
                "description"
              ]
            },
            {
              "resource": "StaffTenantDirectoryRoles",
              "fields": [
                "description"
              ]
            },
            {
              "resource": "StaffTenantGroups",
              "fields": [

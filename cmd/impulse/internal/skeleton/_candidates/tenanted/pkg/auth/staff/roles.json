                "createdAt",
                "startsAt",
                "endsAt"
              ]
            },
            {
              "resource": "StaffTenantGroupRoles",
              "fields": [
                "groupName",
                "createdAt",
                "startsAt",
                "endsAt"
              ]
            },
            {
              "resource": "StaffTenantUserGroupRoles",
              "fields": [
                "username",
                "groupName",
                "globalGroup",
                "everyDomain",
                "startsAt",
                "endsAt"
              ]
            }
          ],
          "Read": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "TenantDirectories",
              "fields": [

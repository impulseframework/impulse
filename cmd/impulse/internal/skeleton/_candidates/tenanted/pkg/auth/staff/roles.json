      {
        "name": "FeatureAdministrator",
        "description": "Turns feature flags on and off for an environment.",
        "permissions": {
          "Execute": [
            {
              "resource": "SetFeature"
            }
          ],
          "List": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ],
          "Read": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ]
        }

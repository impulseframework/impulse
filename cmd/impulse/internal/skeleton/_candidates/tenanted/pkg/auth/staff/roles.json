              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "tenant",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "subject",
                "emailAtLink"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "StaffTenantGroups",
              "fields": [
                "name",
                "description",
                "updatedAt"
              ]
            }
          ],
          "Update": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "title"
              ]
            }
          ]
        }
      }
    ]
  }

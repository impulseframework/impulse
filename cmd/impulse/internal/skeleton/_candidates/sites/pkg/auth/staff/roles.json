{
  "roles": {
    "global": [
      {
        "name": "Administrator",
        "description": "Manages the application's tenants and people: creates tenants, creates accounts and invites people, gives and takes roles, and sets temporary passwords.",
        "permissions": {
          "Create": [
            {
              "resource": "Tenants",
              "fields": [
                "name"
              ]
            }
          ],
          "Delete": [
            {
              "resource": "Tenants"
            }
          ],
          "Execute": [
            {
              "resource": "CreateStaffUser"
            },
            {
              "resource": "DisableStaffUser"
            },
            {
              "resource": "EnableStaffUser"
            },
            {
              "resource": "AssignStaffRole"
            },
            {
              "resource": "RemoveStaffRole"
            },
            {
              "resource": "EndStaffSession"
            },
            {
              "resource": "EndStaffUserSessions"
            },
            {
              "resource": "RequireStaffPasswordChange"
            },
            {
              "resource": "UnlinkStaffSessionIdentity"
            },
            {
              "resource": "RevokeStaffSessionToken"
            },
            {
              "resource": "DeleteStaffUser"
            },
            {
              "resource": "RenameStaffUser"
            },
            {
              "resource": "SetStaffTemporaryPassword"
            },
            {
              "resource": "RevokeStaffUserTrustedDevices"
            },
            {
              "resource": "UnlockStaffSignIn"
            },
            {
              "resource": "InviteStaffUser"
            },
            {
              "resource": "WithdrawStaffInvitation"
            },
            {
              "resource": "SetStaffUserEmail"
            }
          ],
          "List": [
            {
              "resource": "Tenants",
              "fields": [
                "directoryOnly",
                "name"
              ]
            },
            {
              "resource": "StaffSessionUsers",
              "fields": [
                "username",
                "email",
                "emailVerifiedAt",
                "disabled",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ]
            },
            {
              "resource": "StaffSessions",
              "fields": [
                "userId",
                "username",
                "expired",
                "authenticatedAt",
                "createdAt",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffUserRoles",
              "fields": [
                "createdAt"
              ]
            },
            {
              "resource": "StaffSessionIdentities",
              "fields": [
                "connection",
                "createdAt",
                "emailAtLink",
                "lastUsedAt",
                "method",
                "subject",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTokens",
              "fields": [
                "clientId",
                "createdAt",
                "expiresAt",
                "family",
                "kind",
                "lastUsedAt",
                "name",
                "outlet",
                "revokedAt",
                "revokedReason",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionMailLinks",
              "fields": [
                "consumedAt",
                "createdAt",
                "email",
                "expiresAt",
                "invitedBy",
                "kind",
                "roleNames",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionSignInAttempts",
              "fields": [
                "failures",
                "lockedUntil",
                "updatedAt",
                "windowEndsAt"
              ]
            },
            {
              "resource": "StaffSessionAuthEvents",
              "fields": [
                "connection",
                "idpAmr",
                "method",
                "occurredAt"
              ]
            },
            {
              "resource": "StaffRoles",
              "fields": [
                "description",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffRoleGrants",
              "fields": [
                "updatedAt"
              ]
            },
            {
              "resource": "StaffSessionTrustedDevices",
              "fields": [
                "createdAt",
                "expiresAt",
                "lastUsedAt",
                "revokedAt",
                "userId"
              ]
            }
          ],
          "Read": [
            {
              "resource": "Tenants",
              "fields": [
                "directoryOnly",
                "name"
              ]
            },
            {
              "resource": "StaffSessionUsers",
              "fields": [
                "username",
                "email",
                "emailVerifiedAt",
                "disabled",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ]
            },
            {
              "resource": "StaffSessions",
              "fields": [
                "userId",
                "username",
                "expired",
                "authenticatedAt",
                "createdAt",
                "updatedAt"
              ]
            },
            {
              "resource": "StaffSessionIdentities",
              "fields": [
                "connection",
                "createdAt",
                "emailAtLink",
                "lastUsedAt",
                "method",
                "subject",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTokens",
              "fields": [
                "clientId",
                "createdAt",
                "expiresAt",
                "family",
                "kind",
                "lastUsedAt",
                "name",
                "outlet",
                "revokedAt",
                "revokedReason",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionMailLinks",
              "fields": [
                "consumedAt",
                "createdAt",
                "email",
                "expiresAt",
                "invitedBy",
                "kind",
                "roleNames",
                "tenant",
                "userId"
              ]
            },
            {
              "resource": "StaffSessionTrustedDevices",
              "fields": [
                "createdAt",
                "expiresAt",
                "lastUsedAt",
                "revokedAt",
                "userId"
              ]
            }
          ],
          "Update": [
            {
              "resource": "Tenants",
              "fields": [
                "directoryOnly",
                "name"
              ]
            }
          ]
        }
      },
      {
        "name": "FeatureAdministrator",
        "description": "Turns feature flags on and off for an environment.",
        "permissions": {
          "Execute": [
            {
              "resource": "SetFeature"
            }
          ],
          "List": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ],
          "Read": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ]
        }
      }
    ],
    "domain": [
      {
        "name": "TenantAdministrator",
        "description": "Runs one tenant: manages its people and the roles they hold there, declares the directories they sign in through, and posts its announcements.",
        "permissions": {
          "Create": [
            {
              "resource": "TenantDirectories",
              "fields": [
                "connection",
                "defaultSeat",
                "method"
              ]
            },
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "kindId",
                "title"
              ]
            }
          ],
          "Delete": [
            {
              "resource": "TenantDirectories"
            },
            {
              "resource": "Announcements"
            }
          ],
          "Execute": [
            {
              "resource": "CreateStaffTenantUser"
            },
            {
              "resource": "InviteStaffTenantUser"
            },
            {
              "resource": "WithdrawStaffTenantInvitation",
              "condition": "pending = true"
            },
            {
              "resource": "AssignStaffTenantRole"
            },
            {
              "resource": "RemoveStaffTenantRole",
              "condition": "everyDomain = false"
            },
            {
              "resource": "DisableStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "EnableStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "DeleteStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RenameStaffTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "SetStaffTenantUserEmail",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "SetStaffTenantTemporaryPassword",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RequireStaffTenantPasswordChange",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RevokeStaffTenantUserTrustedDevices",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "EndStaffTenantUserSessions",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "UnlinkStaffTenantSessionIdentity",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            }
          ],
          "List": [
            {
              "resource": "TenantDirectories",
              "fields": [
                "connection",
                "defaultSeat",
                "method",
                "tenantId"
              ]
            },
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "kindId",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "StaffTenantUsers",
              "fields": [
                "username",
                "disabled",
                "createdAt",
                "lastSignInAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "StaffTenantUsers",
              "fields": [
                "email",
                "emailVerifiedAt",
                "passwordChangeRequired"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "StaffTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt"
              ]
            },
            {
              "resource": "StaffTenantInvitations",
              "fields": [
                "email",
                "roleNames",
                "invitedBy",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "pending"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "tenant",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "subject",
                "emailAtLink"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "StaffTenantRoles",
              "fields": [
                "description"
              ]
            }
          ],
          "Read": [
            {
              "resource": "TenantDirectories",
              "fields": [
                "connection",
                "defaultSeat",
                "method",
                "tenantId"
              ]
            },
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "kindId",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "StaffTenantUsers",
              "fields": [
                "username",
                "disabled",
                "createdAt",
                "lastSignInAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "StaffTenantUsers",
              "fields": [
                "email",
                "emailVerifiedAt",
                "passwordChangeRequired"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "StaffTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt"
              ]
            },
            {
              "resource": "StaffTenantInvitations",
              "fields": [
                "email",
                "roleNames",
                "invitedBy",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "pending"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "tenant",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "StaffTenantIdentities",
              "fields": [
                "subject",
                "emailAtLink"
              ],
              "condition": "heldElsewhere = false"
            }
          ],
          "Update": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "kindId",
                "title"
              ]
            },
            {
              "resource": "TenantDirectories",
              "fields": [
                "defaultSeat"
              ]
            }
          ]
        }
      }
    ]
  }
}

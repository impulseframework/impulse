{
  "roles": {
    "global": [],
    "domain": [
      {
        "name": "TenantAdministrator",
        "description": "Runs one tenant on the portal: manages its members and the roles they hold there, and posts its announcements.",
        "permissions": {
          "Create": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "title"
              ]
            }
          ],
          "Delete": [
            {
              "resource": "Announcements"
            }
          ],
          "Execute": [
            {
              "resource": "InviteMembersTenantUser"
            },
            {
              "resource": "WithdrawMembersTenantInvitation",
              "condition": "pending = true"
            },
            {
              "resource": "AssignMembersTenantRole"
            },
            {
              "resource": "RemoveMembersTenantRole",
              "condition": "everyDomain = false"
            },
            {
              "resource": "DisableMembersTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "EnableMembersTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "DeleteMembersTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RenameMembersTenantUser",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "SetMembersTenantUserEmail",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "RevokeMembersTenantUserTrustedDevices",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "EndMembersTenantUserSessions",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            },
            {
              "resource": "UnlinkMembersTenantSessionIdentity",
              "condition": "heldElsewhere = false AND heldGlobally = false"
            }
          ],
          "List": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "username",
                "disabled",
                "createdAt",
                "lastSignInAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "email",
                "emailVerifiedAt",
                "passwordChangeRequired"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "MembersTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt"
              ]
            },
            {
              "resource": "MembersTenantInvitations",
              "fields": [
                "email",
                "roleNames",
                "invitedBy",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "pending"
              ]
            },
            {
              "resource": "MembersTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "tenant",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "MembersTenantIdentities",
              "fields": [
                "subject",
                "emailAtLink"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "MembersTenantRoles",
              "fields": [
                "description"
              ]
            }
          ],
          "Read": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "username",
                "disabled",
                "createdAt",
                "lastSignInAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "email",
                "emailVerifiedAt",
                "passwordChangeRequired"
              ],
              "condition": "heldElsewhere = false"
            },
            {
              "resource": "MembersTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt"
              ]
            },
            {
              "resource": "MembersTenantInvitations",
              "fields": [
                "email",
                "roleNames",
                "invitedBy",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "pending"
              ]
            },
            {
              "resource": "MembersTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "tenant",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally"
              ]
            },
            {
              "resource": "MembersTenantIdentities",
              "fields": [
                "subject",
                "emailAtLink"
              ],
              "condition": "heldElsewhere = false"
            }
          ],
          "Update": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "title"
              ]
            }
          ]
        }
      }
    ]
  }
}

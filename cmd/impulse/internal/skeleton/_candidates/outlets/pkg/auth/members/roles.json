{
  "auth": "members",
  "roles": {
    "global": [],
    "domain": [
      {
        "name": "TenantAdministrator",
        "description": "Runs one tenant on the portal: manages its members, their groups and the roles they hold there, and posts its announcements.",
        "permissions": {
          "Create": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "title"
              ]
            }
          ],
          "Delete": [
            {
              "resource": "Announcements"
            }
          ],
          "Execute": [
            {
              "resource": "InviteMembersTenantUser"
            },
            {
              "resource": "WithdrawMembersTenantInvitation",
              "condition": "pending = true"
            },
            {
              "resource": "ResendMembersTenantInvitation"
            },
            {
              "resource": "AssignMembersTenantRole"
            },
            {
              "resource": "RemoveMembersTenantRole",
              "condition": "everyDomain = false"
            },
            {
              "resource": "DisableMembersTenantUser",
              "condition": "managedHere = true"
            },
            {
              "resource": "EnableMembersTenantUser",
              "condition": "managedHere = true"
            },
            {
              "resource": "DeleteMembersTenantUser",
              "condition": "managedHere = true"
            },
            {
              "resource": "RemoveMembersTenantUser"
            },
            {
              "resource": "RenameMembersTenantUser",
              "condition": "managedHere = true"
            },
            {
              "resource": "SetMembersTenantUserEmail",
              "condition": "managedHere = true"
            },
            {
              "resource": "SetMembersTenantUserName",
              "condition": "managedHere = true"
            },
            {
              "resource": "RevokeMembersTenantUserTrustedDevices",
              "condition": "managedHere = true"
            },
            {
              "resource": "EndMembersTenantUserSessions",
              "condition": "managedHere = true"
            },
            {
              "resource": "UnlinkMembersTenantSessionIdentity",
              "condition": "managedHere = true"
            },
            {
              "resource": "CreateMembersTenantGroup"
            },
            {
              "resource": "DescribeMembersTenantGroup"
            },
            {
              "resource": "DeleteMembersTenantGroup"
            },
            {
              "resource": "AddMembersTenantGroupMember"
            },
            {
              "resource": "RemoveMembersTenantGroupMember"
            },
            {
              "resource": "GiveMembersTenantGroupRole"
            },
            {
              "resource": "TakeMembersTenantGroupRole"
            }
          ],
          "List": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "username",
                "name",
                "email",
                "disabled",
                "heldElsewhere",
                "heldGlobally",
                "heldHere",
                "heldInEveryTenant",
                "managedHere",
                "managedByAnotherDirectory",
                "outsideDirectory",
                "cannotEnter",
                "roles",
                "lockedUntil"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "emailVerifiedAt",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ],
              "condition": "managedHere = true"
            },
            {
              "resource": "MembersTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt",
                "startsAt",
                "endsAt",
                "reason"
              ]
            },
            {
              "resource": "MembersTenantHeldRoles",
              "fields": [
                "username",
                "everyDomain",
                "groupName",
                "globalGroup",
                "groupPage",
                "createdAt",
                "startsAt",
                "endsAt",
                "reason"
              ]
            },
            {
              "resource": "MembersTenantInvitations",
              "fields": [
                "email",
                "name",
                "roleNames",
                "invitedByUserId",
                "sentBy",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "withdrawnAt",
                "state",
                "pending"
              ]
            },
            {
              "resource": "MembersTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "subject",
                "tenant",
                "emailAtLink",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally",
                "managedHere",
                "managedByAnotherDirectory"
              ],
              "condition": "managedHere = true"
            },
            {
              "resource": "MembersTenantRoles",
              "fields": [
                "description",
                "method"
              ]
            },
            {
              "resource": "MembersTenantGroups",
              "fields": [
                "name",
                "description",
                "updatedAt",
                "people",
                "roles"
              ]
            },
            {
              "resource": "MembersTenantGroupUsers",
              "fields": [
                "username",
                "name",
                "groupName",
                "createdAt",
                "startsAt",
                "endsAt"
              ]
            },
            {
              "resource": "MembersTenantGroupRoles",
              "fields": [
                "groupName",
                "createdAt",
                "startsAt",
                "endsAt",
                "losing"
              ]
            },
            {
              "resource": "MembersTenantUserGroupRoles",
              "fields": [
                "username",
                "groupName",
                "globalGroup",
                "everyDomain",
                "startsAt",
                "endsAt"
              ]
            }
          ],
          "Read": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "tenantId",
                "title"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "username",
                "name",
                "email",
                "disabled",
                "heldElsewhere",
                "heldGlobally",
                "heldHere",
                "heldInEveryTenant",
                "managedHere",
                "managedByAnotherDirectory",
                "cannotEnter",
                "roles",
                "lockedUntil"
              ]
            },
            {
              "resource": "MembersTenantUsers",
              "fields": [
                "emailVerifiedAt",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt"
              ],
              "condition": "managedHere = true"
            },
            {
              "resource": "MembersTenantUserRoles",
              "fields": [
                "username",
                "everyDomain",
                "createdAt",
                "startsAt",
                "endsAt",
                "reason"
              ]
            },
            {
              "resource": "MembersTenantInvitations",
              "fields": [
                "email",
                "name",
                "roleNames",
                "invitedByUserId",
                "sentBy",
                "createdAt",
                "expiresAt",
                "consumedAt",
                "withdrawnAt",
                "state",
                "pending"
              ]
            },
            {
              "resource": "MembersTenantIdentities",
              "fields": [
                "userId",
                "username",
                "method",
                "connection",
                "subject",
                "tenant",
                "emailAtLink",
                "createdAt",
                "lastUsedAt",
                "heldElsewhere",
                "heldGlobally",
                "managedHere",
                "managedByAnotherDirectory"
              ],
              "condition": "managedHere = true"
            },
            {
              "resource": "MembersTenantGroups",
              "fields": [
                "name",
                "description",
                "updatedAt",
                "people",
                "roles"
              ]
            }
          ],
          "Update": [
            {
              "resource": "Announcements",
              "fields": [
                "body",
                "title"
              ]
            }
          ]
        }
      }
    ]
  }
}

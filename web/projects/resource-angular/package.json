{
  "name": "@impulseframework/resource-angular",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impulseframework/impulse.git",
    "directory": "web/projects/resource-angular"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@impulseframework/resource": "0.2.1"
  },
  "peerDependenciesMeta": {
    "@angular/service-worker": {
      "optional": true
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "impulseframework": {
    "signInSteps": [
      "confirmation",
      "mfa:email-code"

    "./theme": {
      "sass": "./styles/_theme.scss",
      "style": "./styles/_theme.scss",
      "default": "./styles/_theme.scss"
    },
    "./palettes": {
      "sass": "./styles/_palettes.scss",
      "style": "./styles/_palettes.scss",
      "default": "./styles/_palettes.scss"
    },
    "./styles/fonts": {
      "sass": "./styles/_fonts.scss",
      "style": "./styles/_fonts.scss",
      "default": "./styles/_fonts.scss"
    }
  }

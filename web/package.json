{
  "name": "impulse-web",
  "workspaces": [
    "projects/*"
  ],
  "peerDependencies": {
    "@angular/animations": "^21.2.4",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/router": "^21.2.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@fontsource/roboto": "5.3.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-import": "^2.31.0",
    "firebase": "^13.2.0",
    "jsdom": "^31.0.0",
    "madge": "^8.0.0",
    "material-icons": "1.13.14",
    "ng-packagr": "^22.2.6",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.33.1",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "lint": "ng lint",
    "typecheck:resource": "tsc --noEmit -p projects/resource/tsconfig.spec.json",
    "typecheck:firestore": "tsc --noEmit -p projects/resource-firestore/tsconfig.spec.json",
    "fonts": "bun scripts/copy-fonts.mjs",
    "build": "ng build resource && ng build resource-firestore && bun run fonts && ng build resource-angular",
    "test": "bun run test:resource && bun run test:firestore && bun run test:theme && bun run test:angular",
    "test:resource": "bun test projects/resource/ && bun run typecheck:resource",
    "test:firestore": "bun test projects/resource-firestore/ && bun run typecheck:firestore",
    "test:theme": "bun test projects/resource-angular/styles/",
    "test:angular": "ng test resource-angular --watch=false"
  }
}

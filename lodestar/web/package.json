{
  "name": "lodestar-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:console": "ng serve console --no-hmr",
    "start:portal": "ng serve portal --no-hmr",
    "build": "ng build console --define \"APP_VERSION='${VERSION:-dev}'\" && ng build portal --define \"APP_VERSION='${VERSION:-dev}'\"",
    "lint": "ng lint console && ng lint portal",
    "test": "ng test console --watch=false && ng test portal --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@impulseframework/resource": "link:../../web/dist/resource",
    "@impulseframework/resource-angular": "link:../../web/dist/resource-angular",
    "@impulseframework/resource-firestore": "link:../../web/dist/resource-firestore",
    "@contentful/rich-text-types": "^17.2.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "overrides": {
    "@impulseframework/resource": "link:../../web/dist/resource"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.0.10",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.1.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
